---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Sleeve from '../components/Sleeve.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import StringsRule from '../components/StringsRule.astro';
import Award from '../components/Award.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/shez-live.webp';
import { projects } from '../data/projects';
import { releases } from '../data/releases';
import { faq } from '../data/faq';
import { links, person, pressQuote } from '../data/site';
import { absolute, href } from '../lib/url';
import { faqSchema, graph, personSchema, websiteSchema } from '../lib/schema';

const site = Astro.site;
const jsonLd = graph([websiteSchema(site), personSchema(site, absolute('/og/default.jpg', site)), faqSchema(faq)]);
const [latest, ...older] = releases;
---

<Base
  title="Shez Manzoor (SHEZ) | Composer for Film & TV and Singer-Songwriter, London"
  description="Shez Manzoor, aka SHEZ, is a London composer and singer-songwriter. Award-winning music for We Are Lady Parts and Polite Society, and soul and R&B releases as SHEZ."
  path="/"
  type="profile"
  jsonLd={jsonLd}
>
  <Hero />

  <section id="intro" class="intro section" data-section-light="mixed" aria-label="Introduction">
    <div class="wrap intro__grid">
      <Statement
        segments={[
          { text: 'Shez Manzoor writes' },
          { text: 'for the screen', tone: 'green', link: '/composition/' },
          { text: 'and' },
          { text: 'for the stage.', tone: 'purple', link: '/music/' },
          {
            text: 'He scored two series of We Are Lady Parts and co-composed Polite Society. As SHEZ, he writes and sings soul and R&B shaped by jazz, folk, hip hop and the classical music of India and Pakistan.',
          },
        ]}
      />
      <ul class="highlights" role="list">
        <li data-reveal style="--d:0" data-light="green">
          <span class="label">Winner</span>
          <span class="highlights__big">RTS Craft &amp; Design Award</span>
          <span class="highlights__sub">2024 · We Are Lady Parts</span>
        </li>
        <li data-reveal style="--d:1" data-light="green">
          <span class="label">World premiere</span>
          <span class="highlights__big">Sundance 2023</span>
          <span class="highlights__sub">Polite Society</span>
        </li>
        <li data-reveal style="--d:2" data-light="purple">
          <span class="label">Label release</span>
          <span class="highlights__big">Stereofox</span>
          <span class="highlights__sub">2024 · Freeze</span>
        </li>
      </ul>
    </div>
  </section>

  <Marquee />

  <section id="screen" class="section spill" data-light="green" data-section-light="green" aria-labelledby="screen-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="kicker">01 · Film &amp; television</p>
        <h2 id="screen-title">Music for the <em>screen</em></h2>
        <p>
          Scores and original songs for television and film, from the riotous punk of We Are Lady Parts to the
          martial-arts showdowns of Polite Society.
        </p>
      </div>

      <div class="rail" data-reveal>
        <div class="cards" role="list">
          {
            projects.map((p, i) => (
              <div role="listitem">
                <ProjectCard project={p} index={i} />
              </div>
            ))
          }
        </div>
        <div class="rail__progress" aria-hidden="true"><span></span></div>
      </div>

      <Award />

      <div class="section-foot">
        <a class="btn" href={href('/composition/')}>All credits <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section id="music" class="section spill" data-light="purple" data-section-light="purple" aria-labelledby="music-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="kicker">02 · Music as SHEZ</p>
        <h2 id="music-title">Songs as <em>SHEZ</em></h2>
        <p>
          Built on guitar, his songs weave raw soul and R&amp;B vocals with jazz and blues-inspired melody and harmony.
        </p>
      </div>

      <div class="featured">
        <div class="featured__sleeve" data-reveal>
          <Sleeve release={latest} size="lg" caption={false} />
        </div>
        <div class="featured__text" data-reveal style="--d:1">
          <p class="label">Latest release · Instrumental EP</p>
          <h3 class="featured__title">{latest.title}</h3>
          <p class="featured__summary">{latest.summary}</p>
          <div class="featured__actions">
            <a class="btn btn--solid" href={links.spotify} rel="noopener" target="_blank">
              <Icon name="spotify" /> Listen on Spotify
            </a>
            <a class="text-link" href={href(`/music/${latest.slug}/`)}>About the EP <Icon name="arrow" /></a>
          </div>
        </div>
      </div>

      <div class="shelf-head">
        <h3 class="label">Earlier releases</h3>
        <StringsRule />
      </div>
      <div class="shelf" role="list">
        {
          older.map((r, i) => (
            <div role="listitem" data-reveal style={`--d:${i}`}>
              <Sleeve release={r} />
            </div>
          ))
        }
      </div>

      <figure class="quote" data-reveal>
        <blockquote>
          <p>“{pressQuote.text}”</p>
        </blockquote>
        <figcaption>
          <a href={pressQuote.url} rel="noopener" target="_blank">{pressQuote.source}</a>, on Freeze
        </figcaption>
      </figure>

      <div data-reveal>
        <SpotifyEmbed />
      </div>
    </div>
  </section>

  <section id="about" class="section about" data-section-light="mixed" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <figure class="portrait" data-reveal>
        <div class="portrait__frame">
          <Picture
            src={photo}
            alt="Shez Manzoor singing and playing an electric guitar on stage under warm light"
            widths={[360, 540, 720, 960]}
            fallbackFormat="jpg"
            sizes="(min-width: 960px) 40vw, 88vw"
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="label">Live in London</figcaption>
      </figure>
      <div class="about__text">
        <p class="kicker" data-reveal>03 · About</p>
        <h2 id="about-title" data-reveal>One musician, <em>two lights</em></h2>
        <p class="lede about__lede" data-reveal>{person.oneLiner}</p>
        <p class="about__body" data-reveal>
          With a background in vocal and guitar performance and jazz, he draws on folk, soul, hip hop, rock and
          electronic music as well as classical Indian and Pakistani music.
        </p>
        <dl class="about__facts" data-reveal>
          <div><dt class="label">On stage</dt><dd>{person.venues.join(' · ')}</dd></div>
          <div><dt class="label">On air</dt><dd>{person.radio.join(' · ')}</dd></div>
          <div><dt class="label">With</dt><dd>{person.collaborators.join(' · ')}</dd></div>
        </dl>
        <a class="text-link" href={href('/about/')} data-reveal>Full biography <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title" data-section-light="mixed">
    <div class="wrap faq-grid">
      <div class="faq-grid__head" data-reveal>
        <p class="kicker">Questions</p>
        <h2 id="faq-title">Good to <em>know</em></h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  /* ---------- intro ---------- */
  .intro { padding-top: clamp(5rem, 14vw, 10rem); }
  .intro__grid { display: grid; }
  .highlights {
    display: grid;
    gap: 0;
    margin-top: clamp(3rem, 9vw, 6rem);
    padding: 0;
    border-top: 1px solid var(--hair);
  }
  .highlights li {
    display: grid;
    gap: 0.3rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--hair);
  }
  .highlights .label { color: var(--accent); }
  .highlights__big { font-family: var(--serif); font-size: clamp(1.9rem, 7vw, 2.6rem); line-height: 1; }
  .highlights__sub { color: var(--ink-3); font-size: 0.92rem; }

  /* ---------- screen ---------- */
  .rail { position: relative; margin-inline: calc(-1 * var(--gutter)); }
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 360px);
    gap: 0.85rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding: 0.5rem var(--gutter) 1.5rem;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .cards::-webkit-scrollbar { display: none; }
  .cards > div { scroll-snap-align: start; }
  .rail__progress { display: none; }
  @supports (animation-timeline: scroll(x)) {
    .rail { timeline-scope: --cards; }
    .cards { scroll-timeline: --cards x; }
    .rail__progress {
      display: block;
      position: relative;
      height: 2px;
      margin: 0 var(--gutter);
      background: var(--hair);
      border-radius: 2px;
      overflow: hidden;
    }
    .rail__progress span {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, var(--emerald), var(--mint));
      transform-origin: left;
      animation-name: progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-duration: auto;
      animation-timeline: --cards;
    }
    @keyframes progress {
      from { transform: scaleX(0.25); }
      to { transform: scaleX(1); }
    }
  }
  .section-foot { margin-top: 2.5rem; }

  /* ---------- music ---------- */
  .featured { display: grid; gap: 2rem; align-items: center; }
  .featured__title { font-size: clamp(2.6rem, 8vw, 5.2rem); margin-top: 0.8rem; }
  .featured__summary { margin-top: 1rem; color: var(--ink-2); max-width: 44ch; font-size: var(--fs-lede); line-height: 1.5; }
  .featured__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  .featured .label { color: var(--lavender); }

  .shelf-head { display: grid; gap: 1rem; margin-top: clamp(4rem, 12vw, 7rem); margin-bottom: 2rem; }
  .shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70%, 300px);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0.5rem var(--gutter) 1rem;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar { display: none; }
  .shelf > div { scroll-snap-align: start; }

  .quote { margin-block: clamp(4rem, 12vw, 7rem); }
  .quote blockquote p {
    max-width: 19ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 7.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: normal;
    hanging-punctuation: first;
  }
  .quote figcaption { margin-top: 1.25rem; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lavender); }
  .quote figcaption a { color: inherit; }

  /* ---------- about ---------- */
  .about__grid { display: grid; gap: 2.5rem; }
  .portrait { position: relative; }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0b0912;
  }
  .portrait__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: contrast(1.06) brightness(1.12);
    transition: filter 1.4s var(--ease-out);
  }
  .portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(165deg, #d9ccff 0%, #8a63ff 50%, #4b2bb0 100%);
    mix-blend-mode: color;
    transition: opacity 1.4s var(--ease-out);
  }
  .portrait__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgb(11 9 18 / 0.5), transparent 40%);
    pointer-events: none;
  }
  .portrait:hover .portrait__frame :global(img) { filter: none; }
  .portrait:hover .portrait__frame::after { opacity: 0; }
  .portrait figcaption { margin-top: 0.85rem; }

  .about__text h2 { font-size: var(--fs-h2); margin-top: 1.1rem; }
  .about__text h2 em { color: transparent; background: linear-gradient(95deg, var(--lavender), var(--mint)); -webkit-background-clip: text; background-clip: text; padding-right: 0.06em; }
  .about__lede { margin-top: 1.5rem; max-width: 40ch; color: var(--ink); }
  .about__body { margin-top: 1rem; color: var(--ink-2); max-width: 52ch; }
  .about__facts { display: grid; gap: 1rem; margin-block: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--hair); }
  .about__facts dd { margin-top: 0.25rem; color: var(--ink); }

  /* ---------- faq ---------- */
  .faq-grid { display: grid; gap: 2rem; }
  .faq-grid h2 { font-size: var(--fs-h2); margin-top: 1rem; }
  .faq-grid h2 em { color: var(--accent); }

  /* ---------- tablet ---------- */
  @media (min-width: 700px) {
    .highlights { grid-template-columns: repeat(3, 1fr); border-top: 0; gap: 1.25rem; }
    .highlights li { border: 1px solid var(--hair); border-radius: var(--radius); padding: 1.4rem; background: rgb(255 255 255 / 0.015); }
    .cards { grid-auto-columns: min(46%, 380px); }
    .shelf { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); overflow: visible; margin-inline: 0; padding: 0; }
    .featured { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .about__facts { grid-template-columns: repeat(3, 1fr); }
  }

  /* ---------- desktop ---------- */
  @media (min-width: 1100px) {
    .intro__grid { grid-template-columns: 1.6fr 1fr; gap: 5rem; align-items: end; }
    .highlights { grid-template-columns: 1fr; margin-top: 0; gap: 0.9rem; }
    .rail { margin-inline: 0; }
    .cards { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; padding: 0.5rem 0 0; }
    .rail__progress { display: none; }
    .featured { grid-template-columns: 0.9fr 1fr; gap: 5rem; }
    .about__grid { grid-template-columns: 0.85fr 1fr; gap: 6rem; align-items: center; }
    .faq-grid { grid-template-columns: 0.7fr 1.3fr; gap: 5rem; }
    .faq-grid__head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
    .quote { margin-left: 8%; }
  }
</style>
