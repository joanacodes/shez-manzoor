---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StageHero from '../components/stage/StageHero.astro';
import WorkCarousel from '../components/stage/WorkCarousel.astro';
import WorkDetails from '../components/stage/WorkDetails.astro';
import PreviewPlayer from '../components/stage/PreviewPlayer.astro';
import Cinema from '../components/stage/Cinema.astro';
import { thumbOf } from '../lib/thumbs';
import Awards from '../components/Awards.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/shez-live.webp';
import { work, formatDate } from '../data/work';
import { faq } from '../data/faq';
import { bios, links, person, pressQuote } from '../data/site';
import { href } from '../lib/url';
import { faqSchema, graph, personSchema, profilePageSchema, websiteSchema, workSchema } from '../lib/schema';
import { portraitUrl } from '../lib/portrait';

const site = Astro.site;
const title = 'Shez Manzoor | Music Producer, Film & TV Composer, London';
const description =
  'Shez Manzoor (SHEZ) is a London music producer, singer-songwriter and film & TV composer who scored the BAFTA-winning We Are Lady Parts and Polite Society.';
const jsonLd = graph([
  websiteSchema(site),
  profilePageSchema(site, '/', title, description),
  personSchema(site, await portraitUrl(site)),
  workSchema(work, site),
  faqSchema(faq),
]);
const screen = work.filter((w) => w.kind === 'screen');
const records = work.filter((w) => w.kind === 'record').sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const thumbs = new Map(await Promise.all(records.map(async (w) => [w.id, await thumbOf(w.image)] as const)));
---

<Base
  {title}
  {description}
  path="/"
  type="profile"
  jsonLd={jsonLd}
>
  <!-- the 30-second previews stream from here: connect early so the first tap starts sooner -->
  <link rel="preconnect" href="https://audio-ssl.itunes.apple.com" slot="head" />
  <link rel="preconnect" href="https://p.scdn.co" slot="head" />
  <script is:inline slot="head">
    // the header waits for the intro from the first paint; if the stage script never runs, show everything
    document.documentElement.dataset.intro = 'on';
    setTimeout(function () {
      var s = document.querySelector('[data-stage]');
      if (s && !s.dataset.client) {
        document.documentElement.classList.add('no-3d');
        s.dataset.phase = 'ready';
        document.documentElement.dataset.intro = 'off';
      }
    }, 6000);
  </script>

  <StageHero>
    <WorkCarousel items={work} />
  </StageHero>

  <div class="after">
    <!-- ---------- about ---------- -->
    <section id="about" class="section about" aria-labelledby="about-title">
      <div class="wrap about__grid">
        <div class="about__side">
          <Awards />
          <figure class="about__photo" data-reveal data-tint>
            <Picture
              src={photo}
              alt="Shez Manzoor singing and playing an electric guitar on stage under warm light"
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 960px) 40vw, 88vw"
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="label">Live in London</figcaption>
          </figure>
        </div>
        <div class="about__text">
          <p class="kicker" data-reveal>About Shez</p>
          <h2 id="about-title" data-reveal>Producer, singer, <em>songwriter</em>, composer</h2>
          <p class="lede about__lede" data-reveal>{person.oneLiner}</p>
          <div class="about__bio" data-reveal>
            {bios.long.slice(1, 4).map((p) => <p>{p}</p>)}
          </div>
          <dl class="about__facts" data-reveal>
            <div><dt class="label">On stage</dt><dd>{person.venues.join(' · ')}</dd></div>
            <div><dt class="label">On air</dt><dd>{person.radio.join(' · ')}</dd></div>
            <div><dt class="label">With</dt><dd>{person.collaborators.join(' · ')}</dd></div>
          </dl>
          <a class="text-link" href={href('/about/')} data-reveal>Full biography <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <!-- ---------- film and television ---------- -->
    <section id="screen" class="section screen" data-light="green" aria-labelledby="screen-title">
      <Cinema />
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="kicker">Film &amp; television</p>
          <h2 id="screen-title">Music for the <em>screen</em></h2>
          <p>
            Scores and original songs for television and film, from the riotous punk of We Are Lady Parts to the martial-arts
            showdowns of Polite Society.
          </p>
        </div>
        <ul class="credits" role="list">
          {
            screen.map((w, i) => (
              <li data-reveal style={`--d:${i}`}>
                <button class="credit" type="button" data-open-work={w.id}>
                  <span class="credit__art">
                    {w.image ? (
                      <Picture src={w.image} widths={[120, 200, 280]} sizes="(min-width: 700px) 140px, 96px" formats={['avif', 'webp']} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class={`credit__made credit__made--${w.id}`} />
                    )}
                  </span>
                  <span class="credit__text">
                    <span class="credit__cat">
                      {w.category}
                      {w.year && <> · {w.year}</>}
                    </span>
                    <span class="credit__title">{w.title}</span>
                    <span class="credit__role">{w.role}</span>
                    <span class="credit__where">{w.artist}</span>
                  </span>
                  {w.badge && <span class="credit__badge">{w.badge}</span>}
                  <Icon name="plus" class="credit__plus" />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ---------- discography ---------- -->
    <section id="records" class="section records" data-light="purple" aria-labelledby="records-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="kicker">Discography</p>
          <h2 id="records-title">Every <em>record</em></h2>
          <p>
            Singles and EPs as SHEZ, songs with other artists and the Polite Society soundtrack, newest first. Open any of them to
            play it on Apple Music or Spotify.
          </p>
        </div>
        <ol class="disco" role="list">
          {
            records.map((w) => (
              <li class="disco__item" data-reveal>
                <button class="disco__row" type="button" data-open-work={w.id}>
                  <span class="disco__art">
                    {w.image && <Picture src={w.image} widths={[96, 144, 192]} sizes="64px" formats={['avif', 'webp']} alt="" loading="lazy" decoding="async" />}
                  </span>
                  <span class="disco__title">
                    {w.title}
                    <span class="disco__by">{w.artist}</span>
                  </span>
                  <span class="disco__type">{w.category}</span>
                  <time class="disco__date" datetime={w.date}>
                    {formatDate(w.date)}
                  </time>
                  <Icon name="plus" class="disco__plus" />
                </button>
                {w.preview && (
                  <button
                    class="disco__play"
                    type="button"
                    data-preview={w.preview.url}
                    data-preview-title={w.preview.title}
                    data-preview-by={w.artist}
                    data-preview-art={thumbs.get(w.id)}
                    data-preview-apple={w.listen.apple?.url}
                    data-preview-spotify={w.listen.spotify?.url}
                    aria-pressed="false"
                    aria-label={`Play a 30-second preview of ${w.preview.title}`}
                  >
                    <Icon name="play" />
                  </button>
                )}
              </li>
            ))
          }
        </ol>
        <div class="listen-on" data-reveal>
          <a class="btn btn--solid" href={links.spotify} target="_blank" rel="noopener"><Icon name="spotify" /> SHEZ on Spotify</a>
          <a class="btn" href={links.appleMusic} target="_blank" rel="noopener"><Icon name="note" /> Apple Music</a>
          <a class="btn" href={links.soundcloud} target="_blank" rel="noopener"><Icon name="soundcloud" /> SoundCloud</a>
        </div>
        <figure class="quote" data-reveal>
          <blockquote>
            <p>“{pressQuote.text}”</p>
          </blockquote>
          <figcaption>
            <a href={pressQuote.url} rel="noopener" target="_blank">{pressQuote.source}</a>, on Freeze
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ---------- questions ---------- -->
    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div class="faq-grid__head" data-reveal>
          <p class="kicker">Questions</p>
          <h2 id="faq-title">Good to <em>know</em></h2>
        </div>
        <Faq items={faq} />
      </div>
    </section>

    <ContactCta />
  </div>

  <WorkDetails items={work} />
  <PreviewPlayer />
</Base>

<script>
  // the photo of Shez is purple until it reaches 10% of the way down the screen
  const photo = document.querySelector<HTMLElement>('[data-tint]');
  if (photo) {
    new IntersectionObserver(([entry]) => photo.classList.toggle('is-lit', entry.isIntersecting), {
      // the top 10% of the screen: lit from the moment its top edge reaches that line
      rootMargin: '0px 0px -90% 0px',
    }).observe(photo);
  }
</script>

<style>
  /* everything after the stage scrolls over it; the stage stays behind, dimmed (see StageHero) */
  .after {
    position: relative;
    z-index: 1;
  }

  /* ---------- about ---------- */
  .about__grid { display: grid; gap: 2.5rem; }
  /* the awards sit right above his photo */
  .about__side { display: grid; gap: 1.75rem; align-content: start; }
  .about__photo { position: relative; margin: 0; }
  .about__photo :global(picture) {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }
  .about__photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    filter: contrast(1.06) brightness(1.12);
    transition: filter 1.4s var(--ease-out);
  }
  /* purple until the photo reaches 10% of the way down the screen, then its own colours */
  .about__photo :global(picture)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(165deg, #d9ccff 0%, #8a63ff 50%, #4b2bb0 100%);
    mix-blend-mode: color;
    transition: opacity 1.4s var(--ease-out);
    pointer-events: none;
  }
  .about__photo.is-lit :global(img) { filter: none; }
  .about__photo.is-lit :global(picture)::after { opacity: 0; }
  .about__photo figcaption { margin-top: 0.85rem; }
  .about__text h2 { font-size: var(--fs-h2); margin-top: 1.1rem; }
  .about__text h2 em,
  .section-head h2 em {
    color: transparent;
    background: linear-gradient(95deg, var(--lavender), var(--mint));
    -webkit-background-clip: text;
    background-clip: text;
    padding-right: 0.06em;
  }
  .about__lede { margin-top: 1.5rem; max-width: 40ch; color: var(--ink); }
  .about__bio { display: grid; gap: 1rem; margin-top: 1.2rem; color: var(--ink-2); max-width: 58ch; }
  .about__facts { display: grid; gap: 1rem; margin-block: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--hair); }
  .about__facts dd { margin-top: 0.25rem; color: var(--ink); }

  /* ---------- screen ---------- */
  .credits { display: grid; gap: 0.8rem; margin: 0 0 clamp(3rem, 8vw, 5rem); padding: 0; list-style: none; }
  .credit {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1rem;
    align-items: center;
    width: 100%;
    padding: 0.7rem;
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.02);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.3s, background 0.3s;
  }
  .credit:hover { border-color: rgb(var(--mint-rgb) / 0.5); background: rgb(var(--mint-rgb) / 0.05); }
  .credit__art { display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #120e1b; }
  .credit__art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .credit__made { display: block; width: 100%; height: 100%; }
  .credit__made--clarksons-farm { background: repeating-linear-gradient(-28deg, transparent 0 7px, rgb(10 30 14 / 0.55) 7px 9px), linear-gradient(180deg, #e8b765 0%, #c7883e 30%, #4f7a36 31%, #183a1b 100%); }
  .credit__made--bride-or-die { background: linear-gradient(90deg, #0c0a08 0 14%, transparent 14% 86%, #0c0a08 86%), radial-gradient(circle at 50% 40%, #e6563a, #8e1f2b 55%, #2a0b14); }
  .credit__text { display: grid; gap: 0.2rem; padding-right: 2rem; }
  .credit__cat { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--mint); }
  .credit__title { font-family: var(--serif); font-size: clamp(1.5rem, 6vw, 2.1rem); line-height: 1; }
  .credit__role { font-size: 0.9rem; color: var(--ink); }
  .credit__where { font-size: 0.82rem; color: var(--ink-3); }
  .credit__badge {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    display: none;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .credit :global(.credit__plus),
  .disco__row :global(.disco__plus) { position: absolute; right: 0.9rem; bottom: 0.9rem; width: 20px; height: 20px; color: var(--ink-3); transition: transform 0.3s var(--ease-out), color 0.3s; }
  .credit:hover :global(.credit__plus),
  .disco__row:hover :global(.disco__plus) { transform: rotate(90deg); color: var(--ink); }

  /* ---------- discography ---------- */
  .disco { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair); }
  .disco__row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    grid-template-areas: 'art title title' 'art type date';
    column-gap: 1rem;
    align-items: center;
    width: 100%;
    padding: 0.8rem 2.6rem 0.8rem 0;
    border: 0;
    border-bottom: 1px solid var(--hair);
    background: none;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .disco__row:hover { background: linear-gradient(90deg, rgb(var(--violet-rgb) / 0.12), transparent 70%); }
  .disco__item { position: relative; }
  /* a preview button sits on each cover */
  .disco__play {
    position: absolute;
    left: 14px;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(11 9 18 / 0.72);
    color: #fff;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, scale 0.3s var(--ease-out);
  }
  .disco__play :global(svg) { width: 13px; height: 13px; margin-left: 2px; }
  .disco__play:hover,
  .disco__play.is-playing { background: var(--mint); color: #0b0912; scale: 1.08; }
  .disco__art { grid-area: art; display: block; width: 56px; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: #120e1b; }
  .disco__art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .disco__title { grid-area: title; font-family: var(--serif); font-size: 1.3rem; line-height: 1.1; }
  .disco__by { display: block; font-family: var(--sans); font-size: 0.8rem; color: var(--ink-3); margin-top: 0.15rem; }
  .disco__type,
  .disco__date { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lavender); margin-top: 0.3rem; }
  .disco__type { grid-area: type; }
  .disco__date { grid-area: date; justify-self: end; padding-left: 0.75rem; color: var(--ink-3); white-space: nowrap; }
  .disco__row :global(.disco__plus) { top: 50%; bottom: auto; translate: 0 -50%; }

  .listen-on { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }

  .quote { margin-block: clamp(4rem, 12vw, 7rem) 0; }
  .quote blockquote p {
    max-width: 19ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 7.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    hanging-punctuation: first;
  }
  .quote figcaption { margin-top: 1.25rem; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lavender); }
  .quote figcaption a { color: inherit; }

  /* ---------- faq ---------- */
  .faq-grid { display: grid; gap: 2rem; }
  .faq-grid h2 { font-size: var(--fs-h2); margin-top: 1rem; }
  .faq-grid h2 em { color: var(--accent); }

  @media (min-width: 700px) {
    .about__facts { grid-template-columns: repeat(3, 1fr); }
    .credits { grid-template-columns: repeat(2, 1fr); }
    .credit { grid-template-columns: 140px 1fr; padding: 0.9rem; }
    .credit__badge { display: block; }
    .disco__row { grid-template-columns: 64px minmax(0, 1fr) 9rem 11rem; grid-template-areas: 'art title type date'; }
    .disco__art { width: 64px; }
    .disco__play { left: 17px; }
    .disco__type,
    .disco__date { margin-top: 0; }
  }
  @media (orientation: landscape) and (max-height: 520px) {
    .about__grid { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 2.5rem; align-items: start; }
    .about__side { align-self: stretch; }
    .about__photo { position: sticky; top: calc(var(--header-h) + 1rem); }
    .about__photo :global(img) { max-height: 78svh; }
    .faq-grid { grid-template-columns: 0.7fr 1.3fr; gap: 2.5rem; }
    .quote blockquote p { font-size: clamp(1.8rem, 10svh, 3rem); }
  }
  @media (min-width: 1100px) {
    .about__grid { grid-template-columns: 0.85fr 1fr; gap: 6rem; align-items: center; }
    .faq-grid { grid-template-columns: 0.7fr 1.3fr; gap: 5rem; }
    .faq-grid__head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
    .quote { margin-left: 8%; }
  }
</style>
