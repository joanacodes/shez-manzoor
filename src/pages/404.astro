---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found | Shez Manzoor" description="This page could not be found." path="/404/" noindex>
  <section class="lost">
    <svg class="lost__strings" viewBox="0 0 300 120" aria-hidden="true" preserveAspectRatio="none">
      <defs>
        <linearGradient id="lg" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="300" y2="0">
          <stop offset="0" stop-color="#b9a2ff" />
          <stop offset="1" stop-color="#7cefc0" />
        </linearGradient>
      </defs>
      <g stroke="url(#lg)" fill="none" stroke-linecap="round">
        <path d="M0 20H300" stroke-width="1.6" />
        <path d="M0 38H300" stroke-width="1.4" />
        <path d="M0 56H140c10 0 16 8 12 18" stroke-width="1.3" class="snap" />
        <path d="M300 56H176c-8 0-14-10-8-20" stroke-width="1.3" class="snap" />
        <path d="M0 74H300" stroke-width="1.1" />
        <path d="M0 92H300" stroke-width="0.9" />
        <path d="M0 110H300" stroke-width="0.8" />
      </g>
    </svg>
    <div class="wrap lost__text">
      <p class="kicker">404</p>
      <h1>This string <em>snapped.</em></h1>
      <p class="lede">The page you were looking for is not here. Try one of these instead.</p>
      <div class="lost__links">
        <a class="btn btn--solid" href={href('/')}>Home</a>
        <a class="btn" href={href('/composition/')}>Composition</a>
        <a class="btn" href={href('/music/')}>Music</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 92svh; display: grid; align-content: center; gap: 3rem; padding-top: calc(var(--header-h) + 2rem); padding-bottom: 4rem; }
  .lost__strings { width: 100%; height: 140px; opacity: 0.85; }
  .snap { filter: drop-shadow(0 0 6px #cdbbff); }
  .lost h1 { font-size: var(--fs-h1); margin-top: 1rem; }
  .lost h1 em { color: var(--lavender); }
  .lost .lede { margin-top: 1.25rem; }
  .lost__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
