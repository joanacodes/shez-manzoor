---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { href } from '../lib/url';

interface Props extends SeoProps {
  /** Default light for this page: green (composer), purple (artist) or mixed */
  light?: 'green' | 'purple' | 'mixed';
}

const { light = 'mixed', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-GB" data-light={light} data-page-light={light}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0912" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Seo {...seo} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Contact />
    <CookieConsent />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: var(--ink);
    color: var(--stage);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 0.3s var(--ease-out);
  }
  .skip-link:focus-visible { transform: none; }
</style>
