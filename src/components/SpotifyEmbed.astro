---
/** Spotify player that only loads when the visitor asks for it: faster pages, no third-party cookies by default. */
import { links } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  src?: string;
  title?: string;
  heading?: string;
}
const { src = links.spotifyEmbed, title = 'SHEZ on Spotify', heading = 'Play SHEZ' } = Astro.props;
---

<div class="embed" data-embed={src} data-embed-title={title} data-embed-height="352" data-light="purple">
  <div class="embed__eq" aria-hidden="true">
    {Array.from({ length: 24 }, (_, i) => <span style={`--i:${i};--h:${18 + ((i * 37) % 80)}%`} />)}
  </div>
  <div class="embed__body">
    <p class="embed__title">{heading}</p>
    <p class="embed__note">Spotify’s player loads when you press play.</p>
    <div class="embed__actions">
      <button class="btn btn--solid" type="button" data-embed-load>
        <Icon name="play" /> Load the player
      </button>
      <a class="text-link" href={links.spotify} rel="noopener" target="_blank">
        Open in Spotify <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</div>

<style>
  .embed {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    min-height: 352px;
    padding: clamp(1.25rem, 5vw, 2.25rem);
    border-radius: var(--radius);
    border: 1px solid rgb(var(--lavender-rgb) / 0.2);
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(var(--violet-rgb) / 0.35), transparent 65%),
      linear-gradient(180deg, #17122a, #0f0c17);
    overflow: hidden;
    isolation: isolate;
  }
  .embed.is-loaded { padding: 0; border: 0; background: none; min-height: 0; }
  .embed :global(iframe) { display: block; width: 100%; border: 0; border-radius: 14px; }
  .embed__eq {
    position: relative;
    height: clamp(84px, 16vw, 130px);
    display: flex;
    align-items: flex-end;
    gap: 5px;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(to top, #000, transparent);
    mask-image: linear-gradient(to top, #000, transparent);
  }
  .embed__eq span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(to top, var(--violet), var(--lavender));
    transform-origin: bottom;
    animation: eq 2.6s var(--ease-in-out) infinite alternate;
    animation-delay: calc(var(--i) * -0.17s);
  }
  @keyframes eq {
    from { transform: scaleY(0.35); }
    to { transform: scaleY(1); }
  }
  .embed__title { font-family: var(--serif); font-size: clamp(2.2rem, 9vw, 3.4rem); line-height: 1; }
  .embed__note { margin-top: 0.5rem; color: var(--ink-3); font-size: 0.9rem; }
  .embed__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.4rem; }
  @media (prefers-reduced-motion: reduce) {
    .embed__eq span { animation: none; }
  }
</style>
