---
/**
 * The showreel window: a ReelPlayer with a close button. Anything with data-reel-open="<reel>"
 * opens it on that reel and plays it with sound; it is a link to the reel's MP4, which a browser
 * without JavaScript simply plays. On a phone it rises from the bottom of the screen, on a
 * computer it appears in the middle. A link to #showreel opens it too, except on the home page,
 * where the showreel is on the page (that link goes to it). See scripts/showreel.ts.
 */
import Icon from './Icon.astro';
import ReelPlayer from './ReelPlayer.astro';
import { reels } from '../lib/reels';

const any = reels().length > 0;
---

{
  any && (
    <dialog class="reel" id="showreel-window" aria-labelledby="reel-title" data-reel>
      <ReelPlayer variant="dialog" titleId="reel-title">
        <button slot="close" class="reel__close" type="button" data-reel-close aria-label="Close">
          <Icon name="close" />
        </button>
      </ReelPlayer>
    </dialog>
  )
}

<script>
  import '../scripts/showreel';
</script>

<style>
  .reel {
    /* room the head, the choices and the padding take around the video */
    --chrome: 16rem;
    --sheet-max: 1180px;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) max(0.75rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    border: 0;
    color: var(--ink);
    background: rgb(4 3 8 / 0);
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: background-color 0.45s ease;
  }
  .reel[open] { display: flex; }
  .reel::backdrop { background: transparent; }
  .reel.is-open { background: rgb(4 3 8 / 0.9); }
  :global(html:has(.reel[open])) { overflow: hidden; }

  /* phones: it rises from below the screen to the middle, and goes back down */
  .reel :global(.reel__sheet) {
    margin: auto;
    transform: translateY(calc(50vh + 60%));
    transition: transform 0.6s var(--ease-out);
  }
  .reel.is-open :global(.reel__sheet) { transform: none; }
  /* computers: it appears in the middle */
  @media (min-width: 761px) {
    .reel :global(.reel__sheet) {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
      transition: transform 0.5s var(--ease-out), opacity 0.35s ease;
    }
    .reel.is-open :global(.reel__sheet) { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel :global(.reel__sheet) { opacity: 0; transform: none !important; transition: opacity 0.25s ease; }
    .reel.is-open :global(.reel__sheet) { opacity: 1; }
  }

  .reel__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--hair-2);
    background: rgb(255 255 255 / 0.03);
    color: var(--ink);
    cursor: pointer;
  }
  .reel__close:hover { border-color: var(--lavender); }
  .reel__close:focus-visible { outline: 2px solid var(--mint); outline-offset: 2px; }
  .reel__close :global(svg) { width: 20px; height: 20px; }
  /* a phone on its side: the close button at the top of the narrow column */
  @media (orientation: landscape) and (max-height: 520px) {
    .reel__close { align-self: flex-end; width: 36px; height: 36px; }
    .reel__close :global(svg) { width: 17px; height: 17px; }
  }
</style>
