---
import { award } from '../data/site';
import { href } from '../lib/url';
---

<div class="award" data-light="green" data-reveal>
  <div class="award__seal" aria-hidden="true">
    <svg viewBox="0 0 120 120" class="award__ring">
      <defs>
        <path id="award-circle" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" />
      </defs>
      <text>
        <textPath href="#award-circle" textLength="286">RTS CRAFT &amp; DESIGN AWARDS · WINNER 2024 ·</textPath>
      </text>
    </svg>
    <span class="award__core">
      {Array.from({ length: 6 }, (_, i) => <span style={`--i:${i}`} />)}
    </span>
  </div>
  <div class="award__text">
    <p class="label">Winner · {award.name}s {award.year}</p>
    <p class="award__title">{award.category}</p>
    <p class="award__work">
      For <a href={href('/composition/we-are-lady-parts/')}>We Are Lady Parts</a>, series 2. Shared with
      {award.sharedWith.slice(0, -1).join(', ')} and {award.sharedWith.at(-1)}.
    </p>
  </div>
</div>

<style>
  .award {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid rgb(var(--mint-rgb) / 0.25);
    background:
      radial-gradient(70% 120% at 0% 50%, rgb(var(--mint-rgb) / 0.12), transparent 70%),
      rgb(255 255 255 / 0.015);
  }
  .award__seal { position: relative; inline-size: 92px; block-size: 92px; flex: none; }
  .award__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: turn 30s linear infinite; }
  .award__ring text { font-family: var(--mono); font-size: 8.6px; letter-spacing: 0.08em; fill: var(--mint); }
  .award__core {
    position: absolute;
    inset: 30%;
    display: flex;
    justify-content: center;
    gap: 3px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--mint-rgb) / 0.25), transparent 70%);
  }
  .award__core span {
    width: calc(1.6px - var(--i) * 0.15px);
    height: 100%;
    background: linear-gradient(to bottom, transparent, var(--mint) 30%, var(--mint) 70%, transparent);
    box-shadow: 0 0 6px var(--mint);
  }
  .award__title { font-family: var(--serif); font-size: clamp(1.5rem, 5.6vw, 2.3rem); line-height: 1.05; margin-top: 0.35rem; }
  .award__work { margin-top: 0.5rem; color: var(--ink-2); font-size: 0.92rem; max-width: 60ch; }
  .award__work a { color: var(--ink); }
  .award .label { color: var(--mint); }
  @keyframes turn {
    to { transform: rotate(360deg); }
  }
  @media (max-width: 480px) {
    .award { grid-template-columns: 1fr; }
  }
  @media (min-width: 700px) {
    .award { padding: 1.75rem 2rem; gap: 2rem; }
    .award__seal { inline-size: 120px; block-size: 120px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .award__ring { animation: none; }
  }
</style>
