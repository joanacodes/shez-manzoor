---
import { INDEXABLE } from 'astro:env/server';
import { absolute } from '../lib/url';

export interface SeoProps {
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. /music/ */
  path: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'music.album' | 'music.song' | 'video.movie' | 'video.tv_show';
  /** JSON-LD document, already serialised */
  jsonLd?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  image = '/og/default.jpg',
  imageAlt = 'Shez Manzoor, London music producer, singer-songwriter and film and TV composer, singing on stage with an electric guitar',
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props as SeoProps;

const site = Astro.site;
const canonical = absolute(path, site);
const imageUrl = absolute(image, site);
const robots = INDEXABLE && !noindex ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, nofollow';
const imageType = /\.png$/i.test(image) ? 'image/png' : /\.webp$/i.test(image) ? 'image/webp' : 'image/jpeg';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="author" content="Shez Manzoor" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Shez Manzoor" />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:type" content={imageType} />
{
  type === 'profile' && (
    <>
      <meta property="profile:first_name" content="Shez" />
      <meta property="profile:last_name" content="Manzoor" />
      <meta property="profile:username" content="shezrmusic" />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
