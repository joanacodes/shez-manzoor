---
/**
 * The wide card at the top of a project page: the project's real poster (two when the series has
 * artwork for each season) over a soft glow of itself. A drawn title card stands in only when
 * there is no poster.
 */
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { coverFor } from '../data/work';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const cover = coverFor(`/composition/${p.slug}/`);
const posters = cover ? [...(cover.image2 ? [{ src: cover.image2, alt: `Series 1 artwork for ${p.title}` }] : []), { src: cover.image, alt: cover.alt }] : [];
---

{
  cover ? (
    <figure class="tcard tcard--art">
      <Image class="tcard__glow" src={cover.image} alt="" widths={[320]} sizes="320px" loading="lazy" decoding="async" />
      <span class="tcard__posters">
        {posters.map((x) => (
          <Image class="tcard__poster" src={x.src} alt={x.alt} widths={[320, 480, 720, 960]} sizes="(min-width: 960px) 34vw, 46vw" loading="lazy" decoding="async" />
        ))}
      </span>
    </figure>
  ) : (
    <div class="tcard" data-pattern={p.pattern} aria-hidden="true">
      <span class="tcard__pattern" />
      <span class="tcard__title">{p.title}</span>
      <span class="tcard__meta">
        {p.kind}
        {p.years ? ` · ${p.years}` : ''} · Music by Shez Manzoor
      </span>
    </div>
  )
}

<style>
  .tcard {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    aspect-ratio: 16 / 9;
    padding: 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(var(--mint-rgb) / 0.18);
    background:
      radial-gradient(60% 70% at 50% 0%, rgb(var(--mint-rgb) / 0.28), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgb(30 156 115 / 0.3), transparent 70%),
      linear-gradient(180deg, #0f1f18, #0b0912);
    text-align: center;
  }
  .tcard__pattern { position: absolute; inset: 0; z-index: -1; }
  [data-pattern='strings'] .tcard__pattern {
    background: repeating-linear-gradient(100deg, transparent 0 30px, rgb(var(--mint-rgb) / 0.16) 30px 31px);
    -webkit-mask-image: radial-gradient(80% 80% at 50% 30%, #000, transparent);
    mask-image: radial-gradient(80% 80% at 50% 30%, #000, transparent);
  }
  [data-pattern='rings'] .tcard__pattern {
    background: repeating-radial-gradient(circle at 50% 50%, transparent 0 22px, rgb(var(--mint-rgb) / 0.16) 22px 23px);
    -webkit-mask-image: radial-gradient(60% 70% at 50% 50%, #000, transparent);
    mask-image: radial-gradient(60% 70% at 50% 50%, #000, transparent);
  }
  [data-pattern='furrows'] .tcard__pattern {
    inset: 30% -40% 0;
    background: repeating-linear-gradient(90deg, transparent 0 22px, rgb(var(--mint-rgb) / 0.24) 22px 23.5px);
    transform: perspective(400px) rotateX(64deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000, transparent 85%);
    mask-image: linear-gradient(to top, #000, transparent 85%);
  }
  [data-pattern='film'] .tcard__pattern {
    background:
      repeating-linear-gradient(90deg, transparent 0 12px, rgb(var(--mint-rgb) / 0.2) 12px 26px) left 0 top 14px / 100% 10px no-repeat,
      repeating-linear-gradient(90deg, transparent 0 12px, rgb(var(--mint-rgb) / 0.2) 12px 26px) left 0 bottom 14px / 100% 10px no-repeat;
  }
  .tcard__title {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.4rem, 10vw, 6rem);
    line-height: 0.95;
    text-shadow: 0 0 40px rgb(var(--mint-rgb) / 0.35);
  }
  /* the real poster */
  .tcard--art { margin: 0; padding: 0; background: #0b0912; }
  .tcard--art > :global(.tcard__glow) {
    position: absolute;
    inset: -12%;
    z-index: -1;
    width: 124%;
    height: 124%;
    object-fit: cover;
    filter: blur(36px) saturate(1.2) brightness(0.5);
  }
  .tcard__posters { display: flex; justify-content: center; gap: clamp(0.6rem, 2.6vw, 1.5rem); height: 84%; }
  .tcard__posters :global(.tcard__poster) {
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.95);
  }
  .tcard__meta { font-family: var(--mono); font-size: clamp(0.6rem, 2.4vw, 0.75rem); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mint); text-wrap: balance; max-width: 34ch; }
</style>
