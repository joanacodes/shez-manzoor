---
/**
 * A cinema: a big screen playing his film and TV work (the same clips or posters as the TV
 * on the stage), a projector beam, and rows of people in silhouette, lit by the screen.
 */
import Icon from '../Icon.astro';
import { screenChannels } from '../../lib/channels';

const channels = await screenChannels(1200);

/* ---------- the audience, drawn from behind ---------- */
type Who = 'plain' | 'bun' | 'afro' | 'cap' | 'hijab' | 'lean' | 'long';
const f = (n: number) => n.toFixed(1);
const person = (x: number, y: number, s: number, who: Who) => {
  const p: string[] = [];
  // shoulders
  p.push(
    `<path d="M${f(x - 64 * s)} ${f(y)} C${f(x - 64 * s)} ${f(y - 50 * s)} ${f(x - 48 * s)} ${f(y - 72 * s)} ${f(x - 20 * s)} ${f(y - 80 * s)} L${f(x + 20 * s)} ${f(y - 80 * s)} C${f(x + 48 * s)} ${f(y - 72 * s)} ${f(x + 64 * s)} ${f(y - 50 * s)} ${f(x + 64 * s)} ${f(y)} Z"/>`,
  );
  if (who === 'hijab') {
    p.push(
      `<path d="M${f(x - 33 * s)} ${f(y - 74 * s)} C${f(x - 44 * s)} ${f(y - 112 * s)} ${f(x - 36 * s)} ${f(y - 158 * s)} ${f(x)} ${f(y - 160 * s)} C${f(x + 36 * s)} ${f(y - 158 * s)} ${f(x + 44 * s)} ${f(y - 112 * s)} ${f(x + 33 * s)} ${f(y - 74 * s)} Z"/>`,
    );
    return p.join('');
  }
  const hx = who === 'lean' ? x + 10 * s : x;
  p.push(`<rect x="${f(x - 11 * s)}" y="${f(y - 98 * s)}" width="${f(22 * s)}" height="${f(24 * s)}"/>`);
  if (who === 'afro') p.push(`<ellipse cx="${f(hx)}" cy="${f(y - 128 * s)}" rx="${f(37 * s)}" ry="${f(35 * s)}"/>`);
  else
    p.push(
      `<ellipse cx="${f(hx)}" cy="${f(y - 122 * s)}" rx="${f(25 * s)}" ry="${f(29 * s)}"${who === 'lean' ? ` transform="rotate(12 ${f(hx)} ${f(y - 122 * s)})"` : ''}/>`,
    );
  if (who === 'long') p.push(`<path d="M${f(x - 27 * s)} ${f(y - 128 * s)} Q${f(x - 34 * s)} ${f(y - 84 * s)} ${f(x - 30 * s)} ${f(y - 66 * s)} L${f(x + 30 * s)} ${f(y - 66 * s)} Q${f(x + 34 * s)} ${f(y - 84 * s)} ${f(x + 27 * s)} ${f(y - 128 * s)} Z"/>`);
  if (who === 'bun') p.push(`<circle cx="${f(x + 4 * s)}" cy="${f(y - 156 * s)}" r="${f(12 * s)}"/>`);
  if (who === 'cap') p.push(`<ellipse cx="${f(x)}" cy="${f(y - 137 * s)}" rx="${f(28 * s)}" ry="${f(18 * s)}"/>`);
  return p.join('');
};
// seat backs touch each other and merge with the people into one dark mass
const seat = (x: number, y: number, s: number, w: number) =>
  `<path d="M${f(x - w / 2)} ${f(y + 60)} L${f(x - w / 2)} ${f(y - 30 * s)} Q${f(x - w / 2)} ${f(y - 46 * s)} ${f(x - w / 2 + 16 * s)} ${f(y - 46 * s)} L${f(x + w / 2 - 16 * s)} ${f(y - 46 * s)} Q${f(x + w / 2)} ${f(y - 46 * s)} ${f(x + w / 2)} ${f(y - 30 * s)} L${f(x + w / 2)} ${f(y + 60)} Z"/>`;
const row = (seats: [number, Who | null][], y: number, s: number, gap: number) =>
  seats.map(([x, who]) => (who ? person(x, y, s, who) : '') + seat(x, y, s, gap - 6 * s)).join('');
const front = row(
  [
    [80, 'plain'],
    [240, 'long'],
    [400, null],
    [560, 'hijab'],
    [720, 'cap'],
    [880, 'plain'],
    [1040, 'afro'],
    [1200, 'bun'],
  ],
  250,
  0.6,
  160,
);
const back = row(
  [
    [130, 'afro'],
    [370, 'long'],
    [610, 'lean'],
    [850, 'bun'],
    [1090, 'hijab'],
  ],
  380,
  1,
  240,
);
---

<div class="cinema" data-cinema>
  <div class="cinema__room">
    <div class="cinema__beam" aria-hidden="true"></div>
    <div class="cinema__screen" data-cinema-screen role="group" aria-roledescription="slideshow" aria-label="Now showing: his film and television work">
      {
        channels.map((c, i) => (
          <figure class:list={['cinema__slide', i === 0 && 'is-on']} data-cinema-slide data-id={c.id} data-title={c.title} data-kind={c.kind}>
            {c.image ? (
              <>
                <span class="cinema__fill" style={`background-image:url('${c.image}')`} />
                <img class="cinema__poster" src={c.image} alt={`${c.title}, ${c.kind}`} loading="lazy" decoding="async" />
              </>
            ) : (
              <span class={`cinema__card cinema__card--${c.id}`}>
                <span>{c.title}</span>
              </span>
            )}
            {c.video && <video class="cinema__video" muted playsinline loop preload="none" data-src={c.video} aria-hidden="true" />}
          </figure>
        ))
      }
      <span class="cinema__sheen" aria-hidden="true"></span>
    </div>
    <svg class="cinema__audience" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <g class="cinema__row cinema__row--front" set:html={front} />
      <g class="cinema__row cinema__row--back" set:html={back} />
    </svg>
  </div>

  <div class="cinema__caption wrap">
    <p class="label cinema__now">Now showing</p>
    <p class="cinema__title" aria-live="polite">
      <span data-cinema-title>{channels[0]?.title}</span>
      <span class="cinema__kind" data-cinema-kind>{channels[0]?.kind}</span>
    </p>
    <div class="cinema__actions">
      <button class="cinema__btn" type="button" data-open-work={channels[0]?.id} data-cinema-details>Music and credits <Icon name="arrow" /></button>
      <button class="cinema__btn cinema__btn--round" type="button" data-cinema-next aria-label="Next film or series"><Icon name="chevron-right" /></button>
    </div>
  </div>
</div>

<script>
  import '../../scripts/cinema';
</script>

<style>
  .cinema {
    --glow: 205 187 255;
    position: relative;
    margin-bottom: clamp(3rem, 9vw, 5rem);
  }
  .cinema__room {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    padding-top: clamp(1.5rem, 5vw, 3rem);
    overflow: hidden;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  /* the room catches the light of the screen */
  .cinema__room::before {
    content: '';
    position: absolute;
    inset: -10% -20% 0;
    z-index: -2;
    background:
      radial-gradient(60% 55% at 50% 38%, rgb(var(--glow) / 0.22), transparent 70%),
      linear-gradient(180deg, rgb(5 4 9 / 0.4), rgb(5 4 9 / 0.85) 70%);
    transition: background 1.2s ease;
  }

  /* ---------- the screen ---------- */
  .cinema__screen {
    position: relative;
    /* never taller than about two thirds of the viewport (phones held sideways) */
    width: min(92%, 980px, 66svh * 16 / 9);
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: #07060b;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 0 60px -10px rgb(var(--glow) / 0.55),
      0 40px 120px -40px rgb(var(--glow) / 0.6);
    transform: perspective(1400px) rotateX(3deg);
    cursor: pointer;
    transition: box-shadow 1.2s ease;
  }
  .cinema__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .cinema__slide.is-on { opacity: 1; }
  .cinema__fill {
    position: absolute;
    inset: -12%;
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.2) brightness(0.55);
  }
  .cinema__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cinema__slide.is-on .cinema__poster { animation: drift 9s ease-out both; }
  @keyframes drift {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  /* films are wider than the screen: shown whole, with dark bars like a projection */
  .cinema__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #050409;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .cinema__video.is-playing { opacity: 1; }
  .cinema__card {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 8vw, 4.5rem);
    color: #f4efe6;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.6);
  }
  .cinema__card--clarksons-farm {
    background:
      radial-gradient(circle at 78% 22%, rgb(255 214 120 / 0.85) 0 7%, rgb(255 190 90 / 0.25) 8% 20%, transparent 21%),
      repeating-linear-gradient(-14deg, transparent 0 22px, rgb(10 30 14 / 0.5) 22px 28px),
      linear-gradient(180deg, #e8b765 0%, #c7883e 34%, #4f7a36 35%, #2f5d2a 70%, #183a1b 100%);
  }
  .cinema__card--bride-or-die {
    background:
      linear-gradient(90deg, #0c0a08 0 8%, transparent 8% 92%, #0c0a08 92%),
      radial-gradient(circle at 50% 45%, #e6563a, #8e1f2b 55%, #2a0b14);
  }
  .cinema__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
      radial-gradient(120% 90% at 50% 50%, transparent 60%, rgb(0 0 0 / 0.45));
    animation: flicker 5s steps(1) infinite;
  }
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    42% { opacity: 0.85; }
    43% { opacity: 1; }
    77% { opacity: 0.9; }
    78% { opacity: 1; }
  }

  /* ---------- the projector beam, over the heads ---------- */
  .cinema__beam {
    position: absolute;
    z-index: -1;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(0deg, rgb(255 246 230 / 0.2), rgb(var(--glow) / 0.06) 70%, transparent);
    clip-path: polygon(47% 100%, 53% 100%, 96% 6%, 4% 6%);
    filter: blur(6px);
    mix-blend-mode: screen;
    animation: beam 7s ease-in-out infinite;
  }
  @keyframes beam {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }

  /* ---------- the audience ---------- */
  .cinema__audience {
    --h: min(clamp(190px, 50vw, 330px), 46svh);
    width: 100%;
    height: var(--h);
    margin-top: calc(var(--h) * -0.42);
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  /* only the top edges catch the light from the screen */
  .cinema__row { transition: filter 1.2s ease; }
  .cinema__row--front { fill: #0a0810; filter: drop-shadow(0 -1px 0 rgb(var(--glow) / 0.42)) drop-shadow(0 -4px 8px rgb(var(--glow) / 0.12)); }
  .cinema__row--back { fill: #020103; filter: drop-shadow(0 -1.5px 0 rgb(var(--glow) / 0.55)) drop-shadow(0 -8px 14px rgb(var(--glow) / 0.16)); }
  @media (min-width: 900px) {
    .cinema__audience { --h: min(clamp(220px, 26vw, 340px), 40svh); }
  }

  /* ---------- caption ---------- */
  .cinema__caption {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
    margin-top: -0.5rem;
    position: relative;
    z-index: 2;
  }
  .cinema__now { color: var(--mint); }
  .cinema__title { margin: 0; display: grid; gap: 0.1rem; }
  .cinema__title [data-cinema-title] { font-family: var(--serif); font-size: clamp(1.8rem, 7vw, 3rem); line-height: 1; }
  .cinema__kind { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }
  .cinema__actions { display: flex; gap: 0.5rem; margin-top: 0.6rem; }
  .cinema__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--hair-2);
    background: rgb(11 9 18 / 0.6);
    color: var(--ink);
    font: 500 0.9rem/1 var(--sans);
    cursor: pointer;
  }
  .cinema__btn :global(svg) { width: 1em; height: 1em; }
  .cinema__btn--round { width: 44px; padding: 0; justify-content: center; }
  .cinema__btn:hover { border-color: var(--mint); }

  @media (prefers-reduced-motion: reduce) {
    .cinema__slide.is-on .cinema__poster,
    .cinema__sheen,
    .cinema__beam { animation: none; }
  }
</style>
