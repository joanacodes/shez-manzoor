---
/**
 * A cinema: a big screen playing clips of his film and TV work one after another (the same
 * clips as the TV on the stage, always muted), a projector beam, and a full house in
 * silhouette, lit by the film. Without clips there is no cinema.
 */
import Icon from '../Icon.astro';
import { screenChannels } from '../../lib/channels';
import { tvChannels } from '../../data/work';

const channels = screenChannels();
const first = channels[0];
// one caption for all the clips: the works they come from, in the order of the credits
const shown = tvChannels.filter((w) => channels.some((c) => c.id === w.id));
const join = (list: string[]) => (list.length > 1 ? `${list.slice(0, -1).join(', ')} & ${list.at(-1)}` : (list[0] ?? ''));

/* ---------- the audience, drawn from behind ---------- */
type Who = 'plain' | 'bun' | 'afro' | 'cap' | 'hijab' | 'lean' | 'long';
const f = (n: number) => n.toFixed(1);
const person = (x: number, y: number, s: number, who: Who) => {
  const p: string[] = [];
  // shoulders
  p.push(
    `<path d="M${f(x - 64 * s)} ${f(y)} C${f(x - 64 * s)} ${f(y - 50 * s)} ${f(x - 48 * s)} ${f(y - 72 * s)} ${f(x - 20 * s)} ${f(y - 80 * s)} L${f(x + 20 * s)} ${f(y - 80 * s)} C${f(x + 48 * s)} ${f(y - 72 * s)} ${f(x + 64 * s)} ${f(y - 50 * s)} ${f(x + 64 * s)} ${f(y)} Z"/>`,
  );
  if (who === 'hijab') {
    p.push(
      `<path d="M${f(x - 33 * s)} ${f(y - 74 * s)} C${f(x - 44 * s)} ${f(y - 112 * s)} ${f(x - 36 * s)} ${f(y - 158 * s)} ${f(x)} ${f(y - 160 * s)} C${f(x + 36 * s)} ${f(y - 158 * s)} ${f(x + 44 * s)} ${f(y - 112 * s)} ${f(x + 33 * s)} ${f(y - 74 * s)} Z"/>`,
    );
    return p.join('');
  }
  const hx = who === 'lean' ? x + 10 * s : x;
  p.push(`<rect x="${f(x - 11 * s)}" y="${f(y - 98 * s)}" width="${f(22 * s)}" height="${f(24 * s)}"/>`);
  if (who === 'afro') p.push(`<ellipse cx="${f(hx)}" cy="${f(y - 128 * s)}" rx="${f(37 * s)}" ry="${f(35 * s)}"/>`);
  else
    p.push(
      `<ellipse cx="${f(hx)}" cy="${f(y - 122 * s)}" rx="${f(25 * s)}" ry="${f(29 * s)}"${who === 'lean' ? ` transform="rotate(12 ${f(hx)} ${f(y - 122 * s)})"` : ''}/>`,
    );
  if (who === 'long') p.push(`<path d="M${f(x - 27 * s)} ${f(y - 128 * s)} Q${f(x - 34 * s)} ${f(y - 84 * s)} ${f(x - 30 * s)} ${f(y - 66 * s)} L${f(x + 30 * s)} ${f(y - 66 * s)} Q${f(x + 34 * s)} ${f(y - 84 * s)} ${f(x + 27 * s)} ${f(y - 128 * s)} Z"/>`);
  if (who === 'bun') p.push(`<circle cx="${f(x + 4 * s)}" cy="${f(y - 156 * s)}" r="${f(12 * s)}"/>`);
  if (who === 'cap') p.push(`<ellipse cx="${f(x)}" cy="${f(y - 137 * s)}" rx="${f(28 * s)}" ry="${f(18 * s)}"/>`);
  return p.join('');
};
// a full house with no gaps: in each row the shoulders overlap, on a solid dark band (the seats)
const crowd: Who[] = ['plain', 'long', 'bun', 'plain', 'afro', 'hijab', 'cap', 'long', 'plain', 'lean', 'bun', 'afro'];
let seed = 11;
const jitter = () => ((seed = (seed * 16807) % 2147483647) / 2147483647 - 0.5) * 2;
const row = (y: number, s: number, pitch: number, from: number, start: number) => {
  let out = `<rect x="-200" y="${f(y - 40 * s)}" width="1600" height="${f(420 - y + 40 * s)}"/>`;
  for (let x = from, i = start; x <= 1300; x += pitch, i += 5) {
    out += person(x + jitter() * pitch * 0.04, y, s * (1 + jitter() * 0.04), crowd[i % crowd.length]);
  }
  return out;
};
// shoulders are 128 wide at full size: a pitch of 100 to 104 keeps everyone touching
// three rows, smaller with distance, each row's heads clear of the row in front
const far = row(222, 0.5, 50, -60, 3);
const middle = row(296, 0.72, 72, -90, 7);
const near = row(388, 1, 104, -110, 0);
---

{
  first && (
    <div class="cinema" data-cinema>
      <div class="cinema__room">
        <div class="cinema__beam" aria-hidden="true" />
        <div class="cinema__screen" data-cinema-screen role="group" aria-roledescription="slideshow" aria-label="Now showing: clips of his film and television work">
          {channels.map((c, i) => (
            <figure class:list={['cinema__slide', i === 0 && 'is-on']} data-cinema-slide data-video={c.video}>
              {c.still && <img class="cinema__still" src={i === 0 ? c.still : undefined} data-src={c.still} alt="" decoding="async" />}
            </figure>
          ))}
          {/* one player for every clip: once a tap has started it, iPhones let it play the rest */}
          <video class="cinema__video" data-cinema-video muted playsinline preload="none" aria-hidden="true" />
          <button class="cinema__play" type="button" data-cinema-play hidden aria-label="Play the clips">
            <Icon name="play" />
          </button>
          <span class="cinema__sheen" aria-hidden="true" />
        </div>
        <svg class="cinema__audience" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
          <defs>
            {/* light from the screen: the far row catches more of it, the near row only on the tops of heads */}
            <linearGradient id="audience-far" gradientUnits="userSpaceOnUse" x1="0" y1="140" x2="0" y2="360">
              <stop offset="0" class="cinema__light cinema__light--far" />
              <stop offset="1" class="cinema__light cinema__light--far-low" />
            </linearGradient>
            <linearGradient id="audience-middle" gradientUnits="userSpaceOnUse" x1="0" y1="182" x2="0" y2="360">
              <stop offset="0" class="cinema__light cinema__light--middle" />
              <stop offset="1" class="cinema__light cinema__light--middle-low" />
            </linearGradient>
            <linearGradient id="audience-near" gradientUnits="userSpaceOnUse" x1="0" y1="232" x2="0" y2="360">
              <stop offset="0" class="cinema__light cinema__light--near" />
              <stop offset="1" class="cinema__light cinema__light--dark" />
            </linearGradient>
          </defs>
          <g class="cinema__row cinema__row--far" set:html={far} />
          <g class="cinema__row cinema__row--middle" set:html={middle} />
          <g class="cinema__row cinema__row--near" set:html={near} />
        </svg>
      </div>

      <div class="cinema__caption wrap">
        <p class="label cinema__now">Now showing</p>
        <p class="cinema__title">
          <span class="cinema__name">
            {shown.length
              ? shown.map((w, i) => (
                  <>
                    {i > 0 && <em class="cinema__amp">{i === shown.length - 1 ? ' & ' : ', '}</em>}
                    {w.title}
                  </>
                ))
              : 'Music by Shez Manzoor'}
          </span>
          <span class="cinema__kind">{join(shown.map((w) => w.kind)) || 'Film and television'}</span>
        </p>
        <div class="cinema__actions">
          {/* the credits of both are listed right below */}
          <a class="cinema__btn" href="#screen-title">
            Music and credits <Icon name="arrow" />
          </a>
          {channels.length > 1 && (
            <button class="cinema__btn cinema__btn--round" type="button" data-cinema-next aria-label="Next clip">
              <Icon name="chevron-right" />
            </button>
          )}
        </div>
      </div>
    </div>
  )
}

<script>
  import '../../scripts/cinema';
</script>

<style>
  .cinema {
    --glow: 205 187 255;
    --tint: 190 160 255;
    position: relative;
    margin-bottom: clamp(3rem, 9vw, 5rem);
  }
  .cinema__room {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    padding-top: clamp(1.5rem, 5vw, 3rem);
    overflow: hidden;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  /* the room catches the light of the screen */
  .cinema__room::before {
    content: '';
    position: absolute;
    inset: -10% -20% 0;
    z-index: -2;
    background:
      radial-gradient(60% 55% at 50% 38%, rgb(var(--glow) / 0.22), transparent 70%),
      linear-gradient(180deg, rgb(5 4 9 / 0.4), rgb(5 4 9 / 0.85) 70%);
    transition: background 1.2s ease;
  }

  /* ---------- the screen ---------- */
  .cinema__screen {
    position: relative;
    /* never taller than about two thirds of the viewport (phones held sideways) */
    width: min(92%, 980px, 66svh * 16 / 9);
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: #07060b;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 0 60px -10px rgb(var(--glow) / 0.55),
      0 40px 120px -40px rgb(var(--glow) / 0.6);
    transform: perspective(1400px) rotateX(3deg);
    cursor: pointer;
    transition: box-shadow 1.2s ease;
  }
  .cinema__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .cinema__slide.is-on { opacity: 1; }
  /* films are wider than the screen: shown whole, with dark bars like a projection */
  .cinema__still,
  .cinema__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cinema__still { background: #050409; }
  .cinema__video { opacity: 0; transition: opacity 0.5s ease; }
  .cinema__video.is-playing { opacity: 1; }
  /* when the phone wants a tap before playing (Low Power Mode, data saver) */
  .cinema__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: rgb(11 9 18 / 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
  }
  .cinema__play[hidden] { display: none; }
  .cinema__play :global(svg) { width: 22px; height: 22px; margin-left: 3px; }
  .cinema__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
      radial-gradient(120% 90% at 50% 50%, transparent 60%, rgb(0 0 0 / 0.45));
    animation: flicker 5s steps(1) infinite;
  }
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    42% { opacity: 0.85; }
    43% { opacity: 1; }
    77% { opacity: 0.9; }
    78% { opacity: 1; }
  }

  /* ---------- the projector beam, over the heads ---------- */
  .cinema__beam {
    position: absolute;
    z-index: -1;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(0deg, rgb(255 246 230 / 0.2), rgb(var(--glow) / 0.06) 70%, transparent);
    clip-path: polygon(47% 100%, 53% 100%, 96% 6%, 4% 6%);
    filter: blur(6px);
    mix-blend-mode: screen;
    animation: beam 7s ease-in-out infinite;
  }
  @keyframes beam {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }

  /* ---------- the audience ---------- */
  .cinema__audience {
    --h: min(clamp(190px, 50vw, 330px), 46svh);
    width: 100%;
    height: var(--h);
    margin-top: calc(var(--h) * -0.42);
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  /* only the top edges catch the light from the screen */
  .cinema__row { fill: #040307; transition: filter 1.2s ease; }
  .cinema__row--far { fill: url(#audience-far); }
  .cinema__row--middle { fill: url(#audience-middle); }
  .cinema__row--near { fill: url(#audience-near); }
  /* tinted by the film: --tint is the most vivid colour on screen */
  .cinema__light { stop-color: #040307; transition: stop-color 1.2s ease; }
  /* three rows that read apart: the far row, nearest the screen, catches the most light, the near row almost none */
  .cinema__light--far { stop-color: color-mix(in srgb, rgb(var(--tint)) 28%, #15111c); }
  .cinema__light--far-low { stop-color: color-mix(in srgb, rgb(var(--tint)) 14%, #0f0c15); }
  .cinema__light--middle { stop-color: color-mix(in srgb, rgb(var(--tint)) 14%, #0e0b14); }
  .cinema__light--middle-low { stop-color: color-mix(in srgb, rgb(var(--tint)) 6%, #08070c); }
  .cinema__light--near { stop-color: color-mix(in srgb, rgb(var(--tint)) 4%, #040307); }
  .cinema__light--dark { stop-color: #020103; }
  .cinema__row--far { filter: drop-shadow(0 -1px 0 rgb(var(--tint) / 0.3)) drop-shadow(0 -3px 6px rgb(var(--tint) / 0.1)); }
  .cinema__row--middle { filter: drop-shadow(0 -1px 0 rgb(var(--tint) / 0.42)) drop-shadow(0 -5px 10px rgb(var(--tint) / 0.14)); }
  .cinema__row--near { filter: drop-shadow(0 -1.5px 0 rgb(var(--tint) / 0.55)) drop-shadow(0 -8px 14px rgb(var(--tint) / 0.18)); }
  @media (min-width: 900px) {
    .cinema__audience { --h: min(clamp(220px, 26vw, 340px), 40svh); }
  }

  /* ---------- caption ---------- */
  .cinema__caption {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
    margin-top: -0.5rem;
    position: relative;
    z-index: 2;
  }
  .cinema__now { color: var(--mint); }
  .cinema__title { margin: 0; display: grid; gap: 0.1rem; }
  .cinema__name { font-family: var(--serif); font-size: clamp(1.8rem, 7vw, 3rem); line-height: 1.05; text-wrap: balance; }
  .cinema__amp {
    font-style: italic;
    color: transparent;
    background: linear-gradient(95deg, var(--lavender), var(--mint));
    -webkit-background-clip: text;
    background-clip: text;
  }
  .cinema__kind { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }
  .cinema__actions { display: flex; gap: 0.5rem; margin-top: 0.6rem; }
  .cinema__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--hair-2);
    background: rgb(11 9 18 / 0.6);
    color: var(--ink);
    font: 500 0.9rem/1 var(--sans);
    text-decoration: none;
    cursor: pointer;
  }
  .cinema__btn[hidden] { display: none; }
  .cinema__btn :global(svg) { width: 1em; height: 1em; }
  .cinema__btn--round { width: 44px; padding: 0; justify-content: center; }
  .cinema__btn:hover { border-color: var(--mint); }

  @media (prefers-reduced-motion: reduce) {
    .cinema__sheen,
    .cinema__beam { animation: none; }
  }
</style>
