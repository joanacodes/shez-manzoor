---
/**
 * His awards and nominations, impossible to miss: laurels with the year, then what and
 * for which work. Below, the honours won by the productions he scored.
 */
import { honours, productionHonours } from '../../data/site';

// a laurel wreath: leaves along two arcs that meet at the bottom, open at the top
const rad = (deg: number) => (deg * Math.PI) / 180;
const point = (deg: number, r: number) => [50 + Math.cos(rad(deg)) * r, 50 + Math.sin(rad(deg)) * r];
const branch = Array.from({ length: 9 }, (_, i) => {
  const deg = 100 + i * 16; // from the bottom, up the left side
  const side = i % 2 === 0 ? 1 : -1; // leaves alternate outside and inside the stem
  const [x, y] = point(deg, 36 + side * 4.4);
  const travel = (Math.atan2(Math.cos(rad(deg)), -Math.sin(rad(deg))) * 180) / Math.PI;
  return { x, y, tilt: travel + side * 28, size: 1 - i * 0.045 };
});
const wreath = [...branch, ...branch.map((l) => ({ x: 100 - l.x, y: l.y, tilt: 180 - l.tilt, size: l.size }))];
const [sx, sy] = point(96, 36);
const [ex, ey] = point(236, 36);
const stems = `M${sx} ${sy} A36 36 0 0 1 ${ex} ${ey} M${100 - sx} ${sy} A36 36 0 0 0 ${100 - ex} ${ey}`;
---

<section class="honours" aria-labelledby="honours-title">
  <h2 class="kicker honours__kicker" id="honours-title">Awards &amp; nominations</h2>
  <ul class="honours__list" role="list">
    {
      honours.map((h) => (
        <li class:list={['honour', h.result === 'Winner' ? 'honour--won' : 'honour--nominated']}>
          <span class="honour__wreath" aria-hidden="true">
            <svg viewBox="0 0 100 100" focusable="false">
              <path d={stems} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              {wreath.map((l) => (
                <ellipse cx={l.x.toFixed(2)} cy={l.y.toFixed(2)} rx={(8.6 * l.size).toFixed(2)} ry={(3.3 * l.size).toFixed(2)} transform={`rotate(${l.tilt.toFixed(1)} ${l.x.toFixed(2)} ${l.y.toFixed(2)})`} />
              ))}
            </svg>
            <span class="honour__year">{h.year}</span>
          </span>
          <span class="honour__text">
            <span class="honour__result">{h.result}</span>
            <span class="honour__ceremony">{h.ceremony}</span>
            <span class="honour__category">{h.category}</span>
            <span class="honour__work">
              <em>{h.work}</em>
              {h.note && <span> · {h.note}</span>}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
  <p class="honours__also">
    <span class="label">Music for</span>
    {
      productionHonours.map((p, i) => (
        <span class="honours__work">
          <em>{p.work}</em>: {p.items.join(' · ')}
          {i < productionHonours.length - 1 && <span aria-hidden="true"> / </span>}
        </span>
      ))
    }
  </p>
</section>

<style>
  .honours {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(2.5rem, 7vw, 4rem);
  }
  .honours__kicker { margin: 0; font-weight: 400; }
  .honours__list { display: grid; gap: 0.9rem; margin: 0; padding: 0; list-style: none; }
  .honour {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1rem 0.9rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid rgb(var(--tone) / 0.35);
    background: linear-gradient(120deg, rgb(var(--tone) / 0.12), rgb(11 9 18 / 0.5) 60%);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .honour--won { --tone: 240 200 120; }
  .honour--nominated { --tone: 205 187 255; }
  .honour__wreath {
    position: relative;
    display: grid;
    place-items: center;
    width: 76px;
    aspect-ratio: 1;
    color: rgb(var(--tone));
  }
  .honour__wreath svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: currentColor; opacity: 0.9; }
  .honour__year { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; color: rgb(var(--tone)); padding-top: 0.2rem; }
  .honour__text { display: grid; gap: 0.15rem; min-width: 0; }
  .honour__result { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(var(--tone)); }
  .honour__ceremony { font-family: var(--serif); font-size: clamp(1.35rem, 5.4vw, 1.8rem); line-height: 1.05; color: var(--ink); }
  .honour__category { font-size: 0.92rem; color: var(--ink); }
  .honour__work { font-size: 0.85rem; color: var(--ink-2); }
  .honour__work em { font-style: italic; font-family: var(--serif); font-size: 1.05em; }
  .honours__also { display: grid; gap: 0.35rem; margin: 0; font-size: 0.88rem; color: var(--ink-2); }
  .honours__also em { font-family: var(--serif); font-size: 1.1em; color: var(--ink); }
  .honours__also .label { color: var(--mint); }
  .honours__also [aria-hidden] { display: none; }

  @media (min-width: 760px) {
    .honours__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .honour { grid-template-columns: 88px minmax(0, 1fr); }
    .honour__wreath { width: 88px; }
  }
  @media (min-width: 1100px) {
    .honours__also { display: block; }
    .honours__also .label { margin-right: 0.8rem; }
    .honours__also [aria-hidden] { display: inline; color: var(--ink-3); }
  }
</style>
